[global]
    monitor = 0
    follow = mouse

    width = (300, 400)
    height = 300
    origin = top-right
    offset = (16, 46)
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 8
    indicate_hidden = yes

    corner_radius = 16
    transparency = 8
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 8
    frame_width = 2
    frame_color = "#c6b8ff"
    separator_color = frame
    sort = yes

    font = Product Sans 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    sticky_history = yes
    history_length = 20

    dmenu = rofi -dmenu -p dunst -theme ~/.config/rofi/prism.rasi
    browser = vivaldi

    always_run_script = true
    title = Dunst
    class = Dunst

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#211f26"
    foreground = "#e6e0e9"
    timeout = 4

[urgency_normal]
    background = "#211f26"
    foreground = "#e6e0e9"
    timeout = 6

[urgency_critical]
    background = "#93000a"
    foreground = "#ffdad6"
    frame_color = "#ffb4ab"
    timeout = 0
