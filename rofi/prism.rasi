/*
 * Prism rofi theme — Material 3 dark violet/teal, matching
 * ~/.config/hypr/conf/colors.conf. Self-contained (no @theme import).
 */

configuration {
	modi:				"drun,run,window";
	font:				"Product Sans 11";
	show-icons:			true;
	icon-theme:			"Reversal-dark";
	display-drun:			"";
	drun-display-format:		"{name}";
	sidebar-mode:			false;
}

* {
	bg:				#141218e6;
	bg-alt:				#211f26;
	fg:				#e6e0e9;
	fg-alt:				#cac4d0;
	accent:				#c6b8ff;
	on-accent:			#2f2364;
	button:				#2b2930;

	background-color:		@bg;
	text-color:			@fg;
}

window {
	background-color:		@bg;
	border:				2px;
	border-color:			@accent;
	border-radius:			16px;
	width:				38%;
	padding:			6px;
}

mainbox {
	children:			[ inputbar, listview ];
	spacing:			2%;
	padding:			2% 1%;
	background-color:		transparent;
}

inputbar {
	children:			[ prompt, entry ];
	background-color:		@button;
	border-radius:			12px;
	padding:			10px;
}

prompt {
	background-color:		@button;
	text-color:			@accent;
	padding:			0.5% 10px 0% 0%;
}

entry {
	placeholder:			"Search";
	placeholder-color:		@fg-alt;
	background-color:		@button;
	expand:				true;
}

listview {
	columns:			1;
	lines:				8;
	cycle:				true;
	dynamic:			true;
	layout:				vertical;
	spacing:			4px;
}

element {
	orientation:			horizontal;
	padding:			8px 10px;
	border-radius:			10px;
}

element-icon {
	size:				28px;
	vertical-align:			0.5;
}

element-text {
	expand:				true;
	horizontal-align:		0;
	vertical-align:			0.5;
	padding:			0% 0% 0% 8px;
	text-color:			inherit;
}

element normal.normal {
	background-color:		transparent;
	text-color:			@fg;
}

element selected.normal {
	background-color:		@accent;
	text-color:			@on-accent;
}
